FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// STUB - not validated

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295;

boundaryField
{
    inlet
    {
        type            zeroGradient;
        value           uniform 295;
    }
    outlet
    {
        type            zeroGradient;
    }

    defaultFaces
    {
        type            empty;
    }
}

