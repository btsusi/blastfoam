// STUB: SchnerrSauer cavitation mass transfer, added to exercise the
// model. "gas" plays the role of the vapour (dispersed) phase and
// "liquid" the continuous phase. None of these coefficients have been
// validated - see libblastInterfacialModels'
// massTransferModels/SchnerrSauer/SchnerrSauer.H for their meaning.
massTransfer
(
    (gas in liquid)
    {
        type    SchnerrSauer;
        pSat    2300;      // STUB - saturation vapour pressure [Pa]
        n       1.6e13;    // STUB - bubble number density [1/m3]
        dNuc    2e-6;      // STUB - nucleation site diameter [m]
        Cc      1;         // STUB - condensation rate coefficient
        Cv      1;         // STUB - vaporisation rate coefficient
    }
);

