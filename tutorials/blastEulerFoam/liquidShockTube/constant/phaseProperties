gas
{
    phaseType            fluid;

    // STUB: bumped from 0 to a nominal bubble diameter so that "gas" can
    // also act as the dispersed phase of the (gas in liquid) cavitation
    // pair below. This has no effect on the existing (particles/coal in
    // gas) pairs, which key off the dispersed solid's own diameter, not
    // gas's. NOT validated.
    diameterModel constant;
    constantDiameterCoeffs
    {
        d           1e-4;
    }

    type basic;
    thermoType
    {
        transport   const;
        thermo      eConst;
        equationOfState idealGas;
    }
    equationOfState
    {
        gamma           1.4;            // Heat capactiy ratio
    }
    specie
    {
        molWeight       28.97;
    }
    transport
    {
        mu              1.81e-5;
        Pr              1;
    }
    thermodynamics
    {
        type        eConst;
        Cv          718;
        Hf          0;
    }

    residualRho     1e-6;
    residualAlpha   1e-10;
}

// STUB liquid phase - added to host the SchnerrSauer cavitation model
// against "gas" (playing the role of vapour here). Coefficients are
// placeholders only (rough water-like order of magnitude) and have not
// been validated or tuned to this case.
liquid
{
    phaseType            fluid;

    diameterModel constant;
    constantDiameterCoeffs
    {
        d           0;
    }

    type basic;
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState Murnaghan;
    }
    equationOfState
    {
        rho0        1000;      // STUB - not validated
        pRef        1e5;       // STUB - not validated
        K0          2.2e9;     // STUB - not validated
        n           7;         // STUB - not validated
        Gamma       0;         // STUB - not validated
    }
    specie
    {
        molWeight       18.02;
    }
    transport
    {
        mu              8.9e-4;
        Pr              7;
    }
    thermodynamics
    {
        type        eConst;
        Cv          4186;
        Hf          0;
    }

    residualRho     1e-6;
    residualAlpha   1e-10;
}

